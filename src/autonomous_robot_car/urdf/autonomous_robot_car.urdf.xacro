<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonomous_robot_car">

  <xacro:property name="arc_pi" value="3.141592653589793"/>
  <xacro:property name="wheel_radius" value="0.070"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_x" value="0.155"/>
  <xacro:property name="wheel_y" value="0.1925"/>

  <material name="body_blue"><color rgba="0.035 0.22 0.40 1"/></material>
  <material name="accent_cyan"><color rgba="0.0 0.85 0.95 1"/></material>
  <material name="rubber"><color rgba="0.025 0.03 0.035 1"/></material>
  <material name="metal"><color rgba="0.55 0.61 0.66 1"/></material>
  <material name="tray"><color rgba="0.86 0.90 0.92 1"/></material>
  <material name="parcel"><color rgba="0.88 0.48 0.12 1"/></material>
  <material name="glass"><color rgba="0.03 0.08 0.10 1"/></material>
  <material name="red"><color rgba="0.9 0.03 0.03 1"/></material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="${arc_pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin rpy="${arc_pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${arc_pi/2} 0 0"/>
        <mass value="0.18"/>
        <inertia ixx="0.00050" ixy="0" ixz="0" iyy="0.00050" iyz="0" izz="0.00018"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} -0.05"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.01"/>
    </joint>
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- REP-105 ground projection. Wheel contact is at z=0. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.12"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.46 0.34 0.10"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.46 0.34 0.10"/></geometry>
    </collision>
    <xacro:box_inertial mass="3.0" x="0.46" y="0.34" z="0.10"/>
  </link>

  <link name="front_bumper_link">
    <visual>
      <geometry><box size="0.025 0.30 0.065"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <collision><geometry><box size="0.025 0.30 0.065"/></geometry></collision>
    <xacro:box_inertial mass="0.08" x="0.025" y="0.30" z="0.065"/>
  </link>
  <joint name="front_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_bumper_link"/>
    <origin xyz="0.2425 0 -0.005"/>
  </joint>

  <link name="rear_bumper_link">
    <visual>
      <geometry><box size="0.025 0.30 0.065"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <collision><geometry><box size="0.025 0.30 0.065"/></geometry></collision>
    <xacro:box_inertial mass="0.08" x="0.025" y="0.30" z="0.065"/>
  </link>
  <joint name="rear_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_bumper_link"/>
    <origin xyz="-0.2425 0 -0.005"/>
  </joint>

  <xacro:wheel prefix="front_left" x="${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel prefix="front_right" x="${wheel_x}" y="${-wheel_y}"/>
  <xacro:wheel prefix="rear_left" x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel prefix="rear_right" x="${-wheel_x}" y="${-wheel_y}"/>

  <!-- Delivery tray and removable 100 g reference payload. -->
  <link name="tray_pedestal_link">
    <visual><geometry><cylinder radius="0.055" length="0.075"/></geometry><material name="metal"/></visual>
    <collision><geometry><cylinder radius="0.055" length="0.075"/></geometry></collision>
    <inertial><mass value="0.15"/><inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00022"/></inertial>
  </link>
  <joint name="tray_pedestal_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tray_pedestal_link"/>
    <origin xyz="-0.025 0 0.0875"/>
  </joint>

  <link name="delivery_tray_link">
    <visual><geometry><box size="0.34 0.27 0.018"/></geometry><material name="tray"/></visual>
    <collision><geometry><box size="0.34 0.27 0.018"/></geometry></collision>
    <xacro:box_inertial mass="0.24" x="0.34" y="0.27" z="0.018"/>
  </link>
  <joint name="delivery_tray_joint" type="fixed">
    <parent link="tray_pedestal_link"/>
    <child link="delivery_tray_link"/>
    <origin xyz="-0.025 0 0.0465"/>
  </joint>

  <link name="payload_100g_link">
    <visual><geometry><box size="0.13 0.11 0.065"/></geometry><material name="parcel"/></visual>
    <collision><geometry><box size="0.13 0.11 0.065"/></geometry></collision>
    <xacro:box_inertial mass="0.100" x="0.13" y="0.11" z="0.065"/>
  </link>
  <joint name="payload_100g_joint" type="fixed">
    <parent link="delivery_tray_link"/>
    <child link="payload_100g_link"/>
    <origin xyz="-0.055 0 0.0415"/>
  </joint>

  <!-- One top panoramic RGB-D pod: four internal views remove blind spots. -->
  <link name="camera_mount_link">
    <visual><geometry><box size="0.035 0.12 0.18"/></geometry><material name="metal"/></visual>
    <collision><geometry><box size="0.035 0.12 0.18"/></geometry></collision>
    <xacro:box_inertial mass="0.12" x="0.035" y="0.12" z="0.18"/>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="0.17 0 0.17"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.07 0.14 0.055"/></geometry><material name="glass"/></visual>
    <collision><geometry><box size="0.07 0.14 0.055"/></geometry></collision>
    <xacro:box_inertial mass="0.16" x="0.07" y="0.14" z="0.055"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0.025 0 0.105" rpy="0 0.12 0"/>
  </joint>

  <link name="camera_optical_frame">
    <inertial><mass value="0.00001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.037 0 0" rpy="${-arc_pi/2} 0 ${-arc_pi/2}"/>
  </joint>

  <link name="status_led_link">
    <visual><geometry><cylinder radius="0.018" length="0.010"/></geometry><material name="red"/></visual>
    <xacro:box_inertial mass="0.01" x="0.02" y="0.02" z="0.01"/>
  </link>
  <joint name="status_led_joint" type="fixed">
    <parent link="base_link"/>
    <child link="status_led_link"/>
    <origin xyz="-0.18 0 0.06"/>
  </joint>

  <gazebo reference="base_link"><material>Gazebo/DarkBlue</material></gazebo>
  <gazebo reference="delivery_tray_link"><material>Gazebo/White</material></gazebo>
  <gazebo reference="payload_100g_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="camera_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="camera_optical_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

  <gazebo reference="camera_link">
    <sensor name="panoramic_front_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/camera</topic>
      <camera>
        <horizontal_fov>1.74533</horizontal_fov>
        <image><width>640</width><height>360</height><format>R8G8B8</format></image>
        <clip><near>0.12</near><far>8.0</far></clip>
        <depth_camera><output>depths</output></depth_camera>
        <optical_frame_id>camera_optical_frame</optical_frame_id>
      </camera>
    </sensor>
    <sensor name="panoramic_left_rgbd" type="rgbd_camera">
      <pose>0 0 0 0 0 1.570796</pose>
      <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <topic>/camera/left</topic>
      <camera>
        <horizontal_fov>1.74533</horizontal_fov>
        <image><width>320</width><height>180</height><format>R8G8B8</format></image>
        <clip><near>0.12</near><far>8.0</far></clip>
        <depth_camera><output>depths</output></depth_camera>
      </camera>
    </sensor>
    <sensor name="panoramic_right_rgbd" type="rgbd_camera">
      <pose>0 0 0 0 0 -1.570796</pose>
      <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <topic>/camera/right</topic>
      <camera>
        <horizontal_fov>1.74533</horizontal_fov>
        <image><width>320</width><height>180</height><format>R8G8B8</format></image>
        <clip><near>0.12</near><far>8.0</far></clip>
        <depth_camera><output>depths</output></depth_camera>
      </camera>
    </sensor>
    <sensor name="panoramic_rear_rgbd" type="rgbd_camera">
      <pose>0 0 0 0 0 3.141593</pose>
      <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <topic>/camera/rear</topic>
      <camera>
        <horizontal_fov>1.74533</horizontal_fov>
        <image><width>320</width><height>180</height><format>R8G8B8</format></image>
        <clip><near>0.12</near><far>8.0</far></clip>
        <depth_camera><output>depths</output></depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${2.0 * wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>0.55</max_linear_acceleration>
      <min_linear_acceleration>-0.70</min_linear_acceleration>
      <max_angular_acceleration>1.8</max_angular_acceleration>
      <min_angular_acceleration>-1.8</min_angular_acceleration>
      <max_linear_velocity>0.45</max_linear_velocity>
      <min_linear_velocity>-0.20</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
