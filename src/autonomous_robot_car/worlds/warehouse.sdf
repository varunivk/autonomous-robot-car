<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">

    <!-- ================= Physics ================= -->
    <physics name="fast_stable" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <magnetic_field>
      5.64e-6 22.43e-6 -42.82e-6
    </magnetic_field>

    <atmosphere type="adiabatic"/>

    <!-- ================= Scene ================= -->

    <scene>

      <ambient>
        0.58 0.58 0.58 1
      </ambient>

      <background>
        0.12 0.15 0.20 1
      </background>

      <grid>false</grid>

      <shadows>true</shadows>

    </scene>

    <!-- ================= Lighting ================= -->

    <light name="hub_light" type="point">

      <pose>
        -1.0 0 3.5 0 0 0
      </pose>

      <diffuse>
        0.96 0.95 0.92 1
      </diffuse>

      <specular>
        0.25 0.25 0.25 1
      </specular>

      <attenuation>
        <range>15</range>
        <constant>0.30</constant>
        <linear>0.03</linear>
        <quadratic>0.005</quadratic>
      </attenuation>

      <cast_shadows>true</cast_shadows>

    </light>

    <light name="center_light" type="point">

      <pose>
        2.2 0 3.5 0 0 0
      </pose>

      <diffuse>
        0.96 0.95 0.92 1
      </diffuse>

      <specular>
        0.25 0.25 0.25 1
      </specular>

      <attenuation>
        <range>16</range>
        <constant>0.30</constant>
        <linear>0.03</linear>
        <quadratic>0.005</quadratic>
      </attenuation>

      <cast_shadows>true</cast_shadows>

    </light>

    <light name="dock_light" type="point">

      <pose>
        4.6 0 3.5 0 0 0
      </pose>

      <diffuse>
        0.96 0.95 0.92 1
      </diffuse>

      <specular>
        0.25 0.25 0.25 1
      </specular>

      <attenuation>
        <range>14</range>
        <constant>0.30</constant>
        <linear>0.03</linear>
        <quadratic>0.005</quadratic>
      </attenuation>

      <cast_shadows>true</cast_shadows>

    </light>

    <light name="fill_light"
           type="directional">

      <pose>
        0 0 3 0.25 -0.30 0
      </pose>

      <direction>
        -0.25 0.15 -1
      </direction>

      <diffuse>
        0.45 0.50 0.60 1
      </diffuse>

      <specular>
        0.10 0.10 0.10 1
      </specular>

    </light>

    <!-- ================= Floor ================= -->

    <model name="warehouse_floor">

      <static>true</static>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                7.2 8.0 0.10
              </size>

            </box>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <box>

              <size>
                7.2 8.0 0.10
              </size>

            </box>

          </geometry>

          <material>

            <ambient>
              0.32 0.33 0.35 1
            </ambient>

            <diffuse>
              0.42 0.44 0.46 1
            </diffuse>

            <specular>
              0.15 0.15 0.15 1
            </specular>

          </material>

        </visual>

        <pose>
          1.4 0 -0.05 0 0 0
        </pose>

      </link>

    </model>

    <!-- ================= Warehouse Walls ================= -->

    <model name="left_wall">

      <static>true</static>

      <pose>
        -2.2 0 0.60 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                0.10 8.1 1.20
              </size>

            </box>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <box>

              <size>
                0.10 8.1 1.20
              </size>

            </box>

          </geometry>

        </visual>

      </link>

    </model>

    <model name="right_wall">

      <static>true</static>

      <pose>
        5.0 0 0.60 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                0.10 8.1 1.20
              </size>

            </box>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <box>

              <size>
                0.10 8.1 1.20
              </size>

            </box>

          </geometry>

        </visual>

      </link>

    </model>

    <model name="north_wall">

      <static>true</static>

      <pose>
        1.4 4.0 0.60 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                7.3 0.10 1.20
              </size>

            </box>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <box>

              <size>
                7.3 0.10 1.20
              </size>

            </box>

          </geometry>

        </visual>

      </link>

    </model>

    <model name="south_wall">

      <static>true</static>

      <pose>
        1.4 -4.0 0.60 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                7.3 0.10 1.20
              </size>

            </box>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <box>

              <size>
                7.3 0.10 1.20
              </size>

            </box>    <!-- ===================== Warehouse Shelves =====================
         Improved layout:
         - Shelf length increased from 4.0m to 5.0m
