    <!-- ===================== DELIVERY STATIONS ===================== -->

    <!-- RED DELIVERY BAY -->

    <model name="red_delivery_station">

      <static>true</static>

      <pose>
        4.45 -3.00 0.65 0 0 0
      </pose>

      <link name="sign">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                0.12 1.00 0.90
              </size>

            </box>

          </geometry>

        </collision>


        <visual name="visual">

