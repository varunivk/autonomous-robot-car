              </size>

            </box>

          </geometry>


          <material>

            <ambient>
              0.75 0.01 0.01 1
            </ambient>

            <diffuse>
              1.0 0.02 0.02 1
            </diffuse>

            <emissive>
              0.12 0 0 1
            </emissive>

          </material>


        </visual>

      </link>

    </model>


    <model name="red_dock_marker">

      <static>true</static>

      <pose>
